# Database (SQLite file — no external service needed)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Set a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeds the initial admin login (only used the first time the DB is seeded).
ADMIN_EMAIL="admin@permitpilot.local"
APP_PASSWORD="permitpilot"
