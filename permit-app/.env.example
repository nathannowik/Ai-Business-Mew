# Database (SQLite file — no external service needed)
DATABASE_URL="file:./dev.db"

# Auth — signs session cookies; set a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeds the initial admin login (first seed only).
ADMIN_EMAIL="admin@permitpilot.local"
APP_PASSWORD="permitpilot"

# Optional: enable AI township research (search the web + draft a township).
# Get a key at https://console.anthropic.com — leave unset to disable the feature.
# ANTHROPIC_API_KEY="sk-ant-..."
# RESEARCH_MODEL="claude-opus-5"   # optional override (e.g. claude-sonnet-5 for lower cost)
