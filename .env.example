# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change the password before deploying anywhere.
DATABASE_URL="postgresql://mew:mew_dev_password@localhost:5432/mew?schema=public"

# --- API server -------------------------------------------------------------
API_PORT=4000
# Public base URL the API is reachable at (used to build Twilio webhook URLs).
# In local dev use an ngrok/tunnel URL so Twilio can reach your machine.
PUBLIC_API_URL="http://localhost:4000"

# --- Auth -------------------------------------------------------------------
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Encrypts integration secrets (Twilio/email credentials) at rest.
# Generate with `openssl rand -hex 32`. If unset, falls back to JWT_SECRET
# (fine for local dev; set a dedicated key in production).
INTEGRATION_ENCRYPTION_KEY=""

# --- Anthropic (Claude) -----------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
# Default model for reasoning-heavy features (reports, docs, sales analysis).
AI_MODEL="claude-sonnet-5"
# Fast model for the low-latency voice receptionist.
RECEPTIONIST_MODEL="claude-haiku-4-5-20251001"

# --- Twilio (AI Receptionist telephony) -------------------------------------
# Leave blank to run the receptionist in "simulation" mode (no real calls).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Set to "1" to skip Twilio webhook signature verification (e.g. local tunnels
# where the public URL differs). Leave unset in production.
TWILIO_SKIP_VALIDATION=""

# Set to "1" to disable the background scheduler (drip follow-ups, review polling).
DISABLE_SCHEDULER=""

# --- Transcription (Sales Assistant call recordings) ------------------------
# Optional. OpenAI Whisper is used for audio transcription (Claude has no audio
# API). Without this, upload transcription is disabled and you paste transcripts.
OPENAI_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"

# --- Transactional email (verification, password reset, invites) ------------
# Uses Resend (https://resend.com). Leave blank to log emails instead of
# sending (fine for local dev). EMAIL_FROM must be a verified sender in prod.
RESEND_API_KEY=""
EMAIL_FROM="Mew AI <onboarding@resend.dev>"
# Set to "1" to require users to verify their email before signing in.
REQUIRE_EMAIL_VERIFICATION=""

# --- Stripe (billing) -------------------------------------------------------
# Leave blank to run billing in "simulation" mode (plans activate instantly,
# no real charges) so you can build and demo before wiring up Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Web dashboard ----------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Where Stripe Checkout returns the user after success/cancel.
APP_BASE_URL="http://localhost:3000"
