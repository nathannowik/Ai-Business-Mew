// Prisma schema for the AI-business platform.
// Multi-tenant: every row hangs off an Organization (one per client business).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  integrations   Integration[]
  serviceConfigs ServiceConfig[]
  calls          Call[]
  appointments   Appointment[]
  knowledgeDocs  KnowledgeDoc[]
  leads          Lead[]
  chatSessions   ChatSession[]
  subscription   Subscription?
  contentPieces  ContentPiece[]
  documents      Document[]
  reviews        Review[]
  salesCalls     SalesCall[]
  opportunities  Opportunity[]
  activityEvents ActivityEvent[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash    String
  role            Role         @default(owner)
  isPlatformAdmin Boolean      @default(false)
  organizationId  String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

enum Role {
  owner
  admin
  member
}

/// Encrypted-at-rest credentials for an external system (Twilio, CRM, etc.).
/// `config` holds provider-specific JSON. Never return this to the client raw.
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // e.g. "twilio", "google_calendar"
  config         Json
  connected      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
}

/// Per-organization configuration + enablement for a given AI service module.
model ServiceConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceKey     String // matches SERVICE_CATALOG keys, e.g. "receptionist"
  enabled        Boolean      @default(false)
  config         Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, serviceKey])
}

model Call {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalId     String? // Twilio Call SID
  fromNumber     String
  toNumber       String
  status         CallStatus   @default(in_progress)
  summary        String?
  transcript     Json         @default("[]") // CallTurn[]
  startedAt      DateTime     @default(now())
  endedAt        DateTime?

  @@index([organizationId])
  @@index([externalId])
}

enum CallStatus {
  in_progress
  completed
  transferred
  missed
}

model Appointment {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String?
  startsAt        DateTime
  durationMinutes Int          @default(30)
  notes           String?
  source          String       @default("receptionist")
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  source         String       @default("form")
  channel        LeadChannel  @default(form)
  status         LeadStatus   @default(new)
  inquiry        String?
  messages       Json         @default("[]") // LeadMessage[]
  dripStep       Int          @default(0)
  lastOutreachAt DateTime?
  optedOut       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([phone])
}

enum LeadStatus {
  new
  contacted
  qualified
  booked
  lost
}

enum LeadChannel {
  sms
  email
  form
}

/// Per-organization subscription. `simulated` marks plans activated without a
/// real Stripe subscription (Stripe not configured).
model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planKey              String?
  status               String       @default("none")
  simulated            Boolean      @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

/// Marketing Assistant: a generated content piece (post/email/ad/blog).
model ContentPiece {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentType    String
  topic          String
  tone           String       @default("professional")
  title          String
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Document Automation: a generated quote/proposal/invoice/contract.
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docType        String
  title          String
  customerName   String
  content        String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Review Management: a customer review + optional AI-drafted response.
model Review {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         String
  rating         Int
  text           String
  source         String       @default("manual")
  status         String       @default("new")
  draftResponse  String?
  externalId     String? // e.g. Google review id, for dedup on sync
  createdAt      DateTime     @default(now())

  @@unique([organizationId, externalId])
  @@index([organizationId])
}

/// Cross-service activity timeline shown on the dashboard.
model ActivityEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  title          String
  detail         String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, read])
  @@index([organizationId, createdAt])
}

/// A customer-service chat conversation from the public website widget.
model ChatSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transcript     Json         @default("[]") // ChatTurn[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model KnowledgeDoc {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String
  internal       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Sales Assistant: an analyzed sales-call transcript.
model SalesCall {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  transcript     String
  analysis       Json? // SalesCallAnalysis
  followUpDraft  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Sales Assistant: an opportunity in the pipeline.
model Opportunity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  stage          String       @default("new")
  value          Float?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
