{
  "name": "@mew/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Mew AI desktop control panel — the downloadable app clients install and log in to.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron dist/main.js",
    "start": "electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "ai.mew.desktop",
    "productName": "Mew AI",
    "directories": { "output": "release" },
    "files": ["dist/**/*"],
    "mac": { "category": "public.app-category.business" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
