# --- Required ---------------------------------------------------------------
# SQLite file. On Render this points at the persistent disk.
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions (openssl rand -hex 32)
SESSION_SECRET=""
# Public URL of the app — used for links inside emails
APP_URL="http://localhost:3100"

# --- Company settings --------------------------------------------------------
APP_NAME="Owners Hub"
# Everything "today" / "due" is calculated in this timezone
APP_TIMEZONE="America/Chicago"
# Hour (0-23, company timezone) the daily to-do email goes out
REMINDER_HOUR=7

# --- File uploads ------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25

# --- Email (any SMTP provider: Gmail app password, Resend, Postmark, …) -------
# Leave SMTP_HOST empty to just print emails to the server log.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Owners Hub <hub@yourcompany.com>"

# Optional: lets an external cron ping /api/cron/reminders?key=... to send reminders
CRON_SECRET=""

# --- First-run seed (npm run db:seed) ----------------------------------------
SEED_PASSWORD="change-me-now"
SEED_NATHAN_EMAIL="nathan@example.com"
SEED_KYLER_EMAIL="kyler@example.com"
SEED_ISAAC_EMAIL="isaac@example.com"
